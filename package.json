    "object-sizeof": "^1.6.3",
    "odoo-xmlrpc": "^1.0.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "^4.7.0",
    "request-ip": "^3.3.0",
    "sanitize-html": "^2.17.7",
