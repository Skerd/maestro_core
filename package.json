{
  "name": "arepggio_maestror",
  "version": "1.0.0",
  "description": "Arpeggio-Maestro, the server that powers all",
  "author": "Skerd Xhafa",
  "license": "Private project, to be published soon",
  "keywords": [
    ""
  ],
  "main": "",
  "scripts": {
    "clean:js": "find . -name '*.js' ! -path '*/node_modules/*' -delete",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build/copyRuntimeAssets.mjs",
    "fetch:opencv-js": "mkdir -p vendor && curl -fsSL 'https://docs.opencv.org/4.10.0/opencv.js' -o vendor/opencv.js",
    "clean": "find . -name '*.js' ! -path '*/node_modules/*' -delete",
    "test": "vitest run",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "preview:emails": "ts-node --transpile-only -r tsconfig-paths/register scripts/emails/renderEmailPreviews.ts",
    "emails:test": "ts-node --transpile-only -r tsconfig-paths/register scripts/emails/sendTestEmails.ts",
    "sync:demo-companies": "ts-node --transpile-only -r tsconfig-paths/register scripts/syncDemoCompanies.ts",
    "kafka:replay-dlq": "ts-node --transpile-only -r tsconfig-paths/register scripts/replayKafkaDeadLetters.ts",
    "health:rewrap-keys": "ts-node --transpile-only -r tsconfig-paths/register scripts/rewrapHealthDataKeys.ts",
    "media:moderate-existing": "ts-node --transpile-only -r tsconfig-paths/register scripts/moderateExistingMedia.ts",
    "api:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/apiServer.ts",
    "kafka:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/kafkaServer.ts",
    "websocket:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/webSocketServer.ts",
    "cron:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/cronServer.ts",
    "assistant:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/assistantServer.ts",
    "telegram:development": "export NODE_ENV=development && ts-node-dev --transpile-only -r tsconfig-paths/register --respawn --watch ../armonia/src xServers/telegramServer.ts",
    "api": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/apiServer.js",
    "kafka": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/kafkaServer.js",
    "websocket": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/webSocketServer.js",
    "cron": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/cronServer.js",
    "assistant": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/assistantServer.js",
    "telegram": "export NODE_ENV=production && exec node --enable-source-maps -r tsconfig-paths/register xServers/telegramServer.js",
    "dev:ecommerce": "node ../scripts/dev/arpeggio.mjs up ecommerce --only api,websocket,kafka,cron",
    "dev:carRental": "node ../scripts/dev/arpeggio.mjs up carRental --only api,websocket,kafka,cron",
    "dev:dentalClinic": "node ../scripts/dev/arpeggio.mjs up dentalClinic --only api,websocket,kafka,cron",
    "dev:marketplace": "node ../scripts/dev/arpeggio.mjs up marketplace --only api,websocket,kafka,cron",
    "dev:propertyManagement": "node ../scripts/dev/arpeggio.mjs up propertyManagement --only api,websocket,kafka,cron",
    "dev:all": "node ../scripts/dev/arpeggio.mjs up all --only api,websocket,kafka,cron",
    "reset:ecommerce": "node ../scripts/dev/arpeggio.mjs reset ecommerce",
    "reset:carRental": "node ../scripts/dev/arpeggio.mjs reset carRental",
    "reset:dentalClinic": "node ../scripts/dev/arpeggio.mjs reset dentalClinic",
    "reset:marketplace": "node ../scripts/dev/arpeggio.mjs reset marketplace",
    "reset:propertyManagement": "node ../scripts/dev/arpeggio.mjs reset propertyManagement",
    "reset:all": "node ../scripts/dev/arpeggio.mjs reset all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@telegraf/types": "^7.1.0",
